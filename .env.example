# Copy this file to .env and fill in your keys.

# --- LLM provider ---
# "anthropic" (default, needs ANTHROPIC_API_KEY) or "ollama" (free, local,
# needs Ollama running -- see https://ollama.com).
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
CLAUDE_MAX_TOKENS=4096

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Tools ---
# Free key: https://apilayer.com/marketplace/exchangerates_data-api
# Needed only for the convert_currency tool.
APILAYER_API_KEY=

# --- Agent ---
AGENT_MEMORY_MAX_TURNS=20
LOG_LEVEL=INFO
